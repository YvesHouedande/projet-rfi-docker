# Copié en .env par `make init` (ne jamais committer .env).
# Les commentaires restent sur des lignes séparées : pas de commentaire en fin de ligne.

# --- Airflow ---
# Version d'Airflow (figée dans l'image).
AIRFLOW_VERSION=3.3.2
# Renseignés automatiquement par `make init` (uid de l'utilisateur, groupe du socket Docker).
AIRFLOW_UID=
DOCKER_GID=
# Générés par `make init` s'ils sont vides.
FERNET_KEY=
JWT_SECRET=

# --- Base de métadonnées Airflow ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Base de données RFI ---
RFI_POSTGRES_USER=rfi
RFI_POSTGRES_PASSWORD=rfi
RFI_POSTGRES_DB=rfi
# Port publié sur 127.0.0.1 uniquement.
RFI_POSTGRES_PORT=5433

# --- Pipeline ---
# Liste des flux au format JSON, entre apostrophes.
RFI_FEEDS='["https://www.rfi.fr/fr/afrique/rss","https://www.rfi.fr/fr/monde/rss","https://www.rfi.fr/fr/france/rss","https://www.rfi.fr/fr/economie/rss","https://www.rfi.fr/fr/culture/rss"]'
RFI_INGEST_IMAGE=rfi-ingest:latest
RFI_DATA_VOLUME=rfi-data
RFI_DOCKER_NETWORK=rfi-net
# Nombre maximum de fetch simultanés.
RFI_FETCH_CONCURRENCY=3
# Les CSV plus vieux que ce nombre de jours sont purgés.
RFI_RETENTION_DAYS=7

# --- Publication Docker Hub ---
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
RFI_IMAGE_TAG=latest
# Chemin du projet côté hôte, renseigné par `make init`.
RFI_PROJECT_DIR=

# --- SonarQube ---
# Token créé dans SonarQube (Mon compte > Sécurité), utilisé par `make sonar`.
SONAR_TOKEN=
